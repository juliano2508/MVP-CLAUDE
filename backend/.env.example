DATABASE_URL=sqlite:///./agendafacil.db
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRIAL_DAYS=14

# Opcional: se SMTP_HOST não for definido, os emails de confirmação são
# apenas logados no console (útil para desenvolvimento local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@agendafacil.com

FRONTEND_URL=http://127.0.0.1:5173

# Opcional: se STRIPE_SECRET_KEY não for definido, a assinatura roda em modo
# demo (assinar/cancelar mudam o status localmente, sem cobrança real) —
# útil para desenvolvimento local sem uma conta Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
